    {
      "id": "pt-inductor-fp16-softmax-squeeze-reduce-max-duplicate-decl",
      "compiler": "pytorch",
      "target": "cpu",
      "description": "Inductor CPU duplicate Half accumulator declaration for float16 softmax output squeezed then reduced by maximum",
      "severity": "crash",
