{
  "format_version": "1.0",
  "patterns": [
    {
      "id": "pt-inductor-fp16-fused-arith-chain",
      "compiler": "pytorch",
      "target": "cpu",
      "description": "Inductor CPU precision inconsistency: chained float16 arithmetic or concat operations upcast to fp32 in fused C++ kernel exceeding half precision tolerance",
      "severity": "silent_correctness",
      "nodes": [
        {
          "match": "node",
          "id": "n0",
          "op": {
            "$in": [
              "ADD",
              "SUBTRACT",
              "MULTIPLY",
              "DIVIDE",
              "CONCAT"
            ]
          },
          "inputs": [
            "v_in0"
          ],
          "outputs": [
            "v_mid"
          ],
          "attrs": {}
        },
        {
          "match": "node",
          "id": "n1",
          "op": {
            "$in": [
              "ADD",
              "SUBTRACT",
              "MULTIPLY",
              "DIVIDE",
              "CONCAT"
            ]
          },
          "inputs": [
            "v_mid"
          ],
          "outputs": [
            "v_out"
          ],
          "attrs": {}
        }
      ],
      "values": [
        {
          "match": "value",
          "id": "v_mid",
          "dtype": {
            "$eq": "float16"
          }
        }
      ]
    },
    {
      "id": "pt-inductor-fp16-arith-rounding",
      "compiler": "pytorch",
      "target": "cpu",
      "description": "Inductor CPU precision inconsistency: float16 arithmetic or reduction fused into integer rounding (floor/ceil/round/trunc)",
      "severity": "silent_correctness",
      "nodes": [
        {
          "match": "node",
          "id": "n0",
          "op": {
            "$in": [
              "ADD",
              "SUBTRACT",
              "MULTIPLY",
              "DIVIDE",
              "REDUCE_SUM",
              "REDUCE_MEAN",
              "SOFTMAX"
            ]
          },
          "inputs": [
            "v_in"
          ],
          "outputs": [
            "v_mid"
          ],
          "attrs": {}
        },
        {
          "match": "node",
          "id": "n1",
          "op": {
            "$in": [
              "FLOOR",
              "CEIL",
              "ROUND",
              "TRUNC"
            ]
          },
          "inputs": [
            "v_mid"
          ],
          "outputs": [
            "v_out"
          ],
          "attrs": {}
        }
      ],
      "values": [
        {
          "match": "value",
          "id": "v_mid",
          "ndim": {
            "$gte": 2
          },
          "dtype": "float16"
        }
      ]
    },
